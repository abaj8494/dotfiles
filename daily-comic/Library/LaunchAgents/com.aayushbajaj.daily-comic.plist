<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aayushbajaj.daily-comic</string>

    <!-- One comic image per day by mail, at a random time. The script keeps its own
         plan/sent state and is a no-op on every tick but one, so the 60s interval is
         what gives the send time minute resolution — not a polling cost worth tuning. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/aayushbajaj/dotfiles/scripts/daily-comic.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aayushbajaj/Library/Logs/daily-comic.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aayushbajaj/Library/Logs/daily-comic.launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/aayushbajaj</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityBackgroundIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
