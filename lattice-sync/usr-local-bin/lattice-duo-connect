#!/bin/sh
# Triggered by udev (via systemd-run) when the lattice-parity Duo is plugged in.
# NON-DESTRUCTIVE: mounts the Duo and notifies the desktop. Does NOT sync;
# the user runs `lattice-sync` explicitly to do the guarded 2-way Unison.
DUO_UUID=70c0e587-2c6e-4a92-8242-b81d079f83d5
MNT=/mnt/lattice-parity
USER_NAME=adoosh
UID_N=$(id -u "$USER_NAME" 2>/dev/null || echo 1000)

mkdir -p "$MNT"
mountpoint -q "$MNT" || mount "/dev/disk/by-uuid/$DUO_UUID" "$MNT" 2>/dev/null
chown "$USER_NAME":"$USER_NAME" "$MNT" 2>/dev/null || true

runuser -u "$USER_NAME" -- env \
    DISPLAY=:0 \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_N/bus" \
    notify-send -u normal "Lattice Duo connected" \
        "Mounted at $MNT. Run  lattice-sync  to 2-way sync with Percy." 2>/dev/null || true
