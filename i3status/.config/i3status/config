# i3status — kali bottom bar (managed via ~/dotfiles, branch: kali)
general {
    colors = true
    interval = 5
    color_good     = "#9ccfd8"
    color_degraded = "#f6c177"
    color_bad      = "#eb6f92"
    separator = "  "
}

order += "disk /"
order += "memory"
order += "cpu_usage"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

disk "/" {
    format = "disk %avail"
}

memory {
    format = "mem %used"
    threshold_degraded = "1G"
    format_degraded = "mem LOW %available"
}

cpu_usage {
    format = "cpu %usage"
}

wireless _first_ {
    format_up   = "wifi %essid %quality"
    format_down = "wifi down"
}

ethernet _first_ {
    format_up   = "eth %ip"
    format_down = ""
}

battery all {
    format = "bat %status %percentage"
    status_chr  = "CHR"
    status_bat  = "BAT"
    status_full = "FULL"
    low_threshold = 15
    integer_battery_capacity = true
}

tztime local {
    format = "%a %Y-%m-%d  %H:%M"
}
