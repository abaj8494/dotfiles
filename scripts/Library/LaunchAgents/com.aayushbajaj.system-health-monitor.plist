<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aayushbajaj.system-health-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/aayushbajaj/.local/bin/watchdog</string>
        <string>collect</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aayushbajaj/Library/Logs/system-health/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aayushbajaj/Library/Logs/system-health/launchd-stderr.log</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityBackgroundIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
