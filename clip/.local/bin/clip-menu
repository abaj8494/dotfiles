#!/bin/bash
# Alfred-style clipboard history menu in rofi, backed by greenclip, WITH image previews.
# (bash, not sh: dash's printf can't emit the \x1f byte the rofi icon protocol needs.)
# Bound to double-tap Left-Alt via keyd. Selecting an entry copies it to the clipboard;
# clip-sync then propagates it to clip.abaj.ai (Mac / reMarkable).
#
# greenclip prints image entries as a plain "image/png <id>" line (no icon metadata) and
# caches the thumbnail at $CACHE/<id>.png. We inject rofi's dmenu icon protocol
# (text \0 icon \x1f path) so the thumbnail renders as a preview. Absolute paths because
# i3's exec PATH lacks ~/.local/bin.
GREENCLIP="$HOME/.local/bin/greenclip"
CACHE="${GREENCLIP_IMAGE_CACHE:-/tmp/greenclip}"

list() {
    "$GREENCLIP" print | while IFS= read -r line; do
        case "$line" in
            image/png*)
                id=$(printf '%s' "$line" | awk '{print $NF}')
                thumb="$CACHE/$id.png"
                if [ -f "$thumb" ]; then
                    printf '%s\0icon\x1f%s\n' "$line" "$thumb"
                else
                    printf '%s\n' "$line"
                fi
                ;;
            *) printf '%s\n' "$line" ;;
        esac
    done
}

sel="$(list | rofi -dmenu -i -p "clipboard" -show-icons \
        -theme-str 'window { width: 50%; } listview { lines: 12; } element-icon { size: 2.6em; }')" || exit 0
[ -n "$sel" ] && "$GREENCLIP" print "$sel"   # re-copies the selected entry (text or image) to the clipboard
