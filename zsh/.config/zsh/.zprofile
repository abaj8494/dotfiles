
# Lambda Mind desktop: directories the λ agent may read beyond the vault
# (colon-separated; lib/chat.js passes each as --add-dir). Downloads for
# freshly downloaded textbooks/papers; 2-areas/study for the
# certifications tree map.md points at.
export LMIND_ADD_DIRS="$HOME/lattice/org-notes:$HOME/Downloads:$HOME/lattice/2-areas/study"
