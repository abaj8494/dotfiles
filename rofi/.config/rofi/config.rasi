/* rofi config — kali (managed via ~/dotfiles, branch: kali)
 * Raycast has no Linux build; rofi is the i3-native launcher equivalent.
 * Theme: Rosé Pine (distinct from Percy's palette), shared by launcher + clip-menu.
 */
configuration {
    modi:                "drun,run,window,filebrowser";
    show-icons:          true;
    drun-display-format: "{name}";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    display-filebrowser: "Files";
    terminal:            "alacritty";
    kb-cancel:           "Escape";
    sidebar-mode:        true;
}

* {
    bg0:     #191724;   /* base    */
    bg1:     #1f1d2e;   /* surface */
    bg2:     #26233a;   /* overlay */
    fg0:     #e0def4;   /* text    */
    fg1:     #908caa;   /* subtle  */
    accent:  #9ccfd8;   /* foam    */
    accent2: #c4a7e7;   /* iris    */
    urgent:  #eb6f92;   /* love    */
    trans:   rgba(0,0,0,0%);
}

window {
    width:            640px;
    border:           2px;
    border-color:     @accent;
    border-radius:    16px;
    background-color: @bg0;
    padding:          0;
}

mainbox {
    padding:          18px;
    spacing:          14px;
    background-color: @trans;
}

inputbar {
    background-color: @bg2;
    text-color:       @fg0;
    padding:          12px 16px;
    border-radius:    12px;
    spacing:          10px;
    children:         [ prompt, entry ];
}
prompt { text-color: @accent2; }
entry  { text-color: @fg0; placeholder: "Search…"; placeholder-color: @fg1; }

listview {
    lines:            10;
    spacing:          6px;
    scrollbar:        false;
    background-color: @trans;
}

element {
    padding:          10px 12px;
    border-radius:    10px;
    spacing:          12px;
    background-color: @trans;
    text-color:       @fg0;
}
element selected {
    background-color: @accent;
    text-color:       @bg0;
}
element-icon { size: 1.3em; background-color: @trans; }
element-text { background-color: @trans; text-color: inherit; }

mode-switcher { spacing: 8px; }
button          { padding: 8px 14px; border-radius: 10px; background-color: @bg2; text-color: @fg1; }
button selected { background-color: @accent2; text-color: @bg0; }
