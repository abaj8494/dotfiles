set cleaner ~/.config/lf/clean
set previewer ~/.config/lf/preview


set ifs "\n"

set hidden true

# from default rc
set shell sh
#set shellopts '-eu'
#set ifs "\n"

set icons
#set dircounts
map ff $lf -remote "send $id select \"$(fzf)\""
map ss &tmux split-window -h lf
map s- &tmux split-window -v lf

cmd zip ${{
	zip -r "$f".zip "$f"
}}
cmd tar %tar cvf "$f.tar" "$f"
cmd unzip ${{
	unzip "$f"
}}

cmd wall ${{
	wallpaper set "$f"
}}

cmd mkdir ${{
	printf "Directory name: "
	read ans
	mkdir "$ans"
}}

cmd mkfile ${{
	printf "File name: "
	read ans
	touch "$ans"
}}


cmd trash ${{
  printf '%s\n' "$fx" | while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || { printf 'trash: missing: %s\n' "$p" >&2; continue; }

    /usr/bin/osascript - "$p" <<'APPLESCRIPT'
on run argv
  set p to item 1 of argv
  set a to (POSIX file p) as alias
  tell application "Finder"
    delete a
  end tell
end run
APPLESCRIPT
  done
}}


cmd restore_trash ${{
  printf '%s\n' "$fx" | while IFS= read -r p; do
    [ -n "$p" ] && command trash-putback "$p"
  done
}}

# --- Empty Trash (with confirmation) ---
cmd clear_trash ${{
  printf "Empty macOS Trash? This is permanent. [y/N] "
  read ans
  case "$ans" in
    y|Y)
      /usr/bin/osascript -e 'tell application "Finder" to empty the trash'
      ;;
  esac
}}


cmd brave ${{
	open -a "Google Chrome.app" "$f"
}}

cmd open_selected ${{
    echo "$fs" | xargs -I{} open -a "Brave Browser Beta.app" {}
}}


cmd yank-path $printf '%s' "$fx" | pbcopy
