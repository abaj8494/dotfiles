}}


cmd trash ${{
  printf '%s\n' "$fx" | while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || { printf 'trash: missing: %s\n' "$p" >&2; continue; }

    /usr/bin/osascript - "$p" <<'APPLESCRIPT'
on run argv
  set p to item 1 of argv
  set a to (POSIX file p) as alias
  tell application "Finder"
    delete a
  end tell
end run
APPLESCRIPT
  done
}}


cmd restore_trash ${{
  printf '%s\n' "$fx" | while IFS= read -r p; do
    [ -n "$p" ] && command trash-putback "$p"
  done
}}

# --- Empty Trash (with confirmation) ---
cmd clear_trash ${{
  printf "Empty macOS Trash? This is permanent. [y/N] "
  read ans
  case "$ans" in
    y|Y)
      /usr/bin/osascript -e 'tell application "Finder" to empty the trash'
      ;;
  esac
}}


cmd brave ${{
	open -a "Google Chrome.app" "$f"
}}

cmd open_selected ${{
    echo "$fs" | xargs -I{} open -a "Brave Browser Beta.app" {}
}}


cmd yank-path ${{
    if command -v pbcopy >/dev/null 2>&1; then
        printf '%s' "$fx" | pbcopy
    else
        data=$(printf '%s' "$fx" | base64 | tr -d '\n')
        if [ -n "$TMUX" ]; then
            printf '\ePtmux;\e\e]52;c;%s\a\e\\' "$data" > /dev/tty
        else
            printf '\e]52;c;%s\a' "$data" > /dev/tty
        fi
    fi
    lf -remote "send $id echo \"Copied: $fx\""
}}
cmd yank-filepath &{{
    if command -v pbcopy >/dev/null 2>&1; then
        printf '%s' "$f" | pbcopy
    else
        data=$(printf '%s' "$f" | base64 | tr -d '\n')
        if [ -n "$TMUX" ]; then
            printf '\ePtmux;\e\e]52;c;%s\a\e\\' "$data" > /dev/tty
        else
            printf '\e]52;c;%s\a' "$data" > /dev/tty
        fi
    fi
    lf -remote "send $id echo \"Copied: $f\""
}}
