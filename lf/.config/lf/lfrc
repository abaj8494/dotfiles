# lf config — kali  (managed via ~/dotfiles, branch: kali)
# Ported from Percy's lfrc, adapted for Linux:
#   trash:  macOS osascript  -> trash-cli (trash-put/trash-empty/trash-restore)
#   clip:   pbcopy           -> xclip (X11), with OSC52 fallback
#   open:   open -a App      -> xdg-open / brave-browser
#   paths:  ~/Google Drive   -> kali paths + lattice parity mount

set shell sh
set ifs "\n"
set hidden true
set icons
set drawbox
set scrolloff 5
set previewer ~/.config/lf/preview.sh

# --- navigation helpers ---------------------------------------------------
map ff $lf -remote "send $id select \"$(fzf)\""
map ss &tmux split-window -h lf
map s- &tmux split-window -v lf

# --- archives -------------------------------------------------------------
cmd zip ${{ zip -r "$f".zip "$f" }}
cmd tar %tar cvf "$f.tar" "$f"
cmd unzip ${{ unzip "$f" }}

# --- create ---------------------------------------------------------------
cmd mkdir ${{ printf "Directory name: "; read ans; mkdir -p -- "$ans" }}
cmd mkfile ${{ printf "File name: "; read ans; : > "$ans" }}

# --- trash (trash-cli) ----------------------------------------------------
cmd trash ${{
  printf '%s\n' "$fx" | while IFS= read -r p; do
    [ -n "$p" ] && trash-put -- "$p"
  done
}}
cmd clear_trash ${{
  printf "Empty trash? This is permanent. [y/N] "
  read ans
  case "$ans" in y|Y) trash-empty -f ;; esac
}}
cmd restore_trash ${{ trash-restore }}

# --- yank path to clipboard (xclip on X11, OSC52 fallback) ----------------
cmd yank-path ${{
  if command -v xclip >/dev/null 2>&1; then
    printf '%s' "$fx" | xclip -selection clipboard
  else
    data=$(printf '%s' "$fx" | base64 | tr -d '\n')
    printf '\033]52;c;%s\a' "$data" > /dev/tty
  fi
  lf -remote "send $id echo Copied: $fx"
}}

# --- openers --------------------------------------------------------------
cmd open &{{ setsid -f xdg-open "$f" >/dev/null 2>&1 }}
cmd brave &setsid -f brave-browser "$f" >/dev/null 2>&1

# --- clear defaults we re-map --------------------------------------------
map m
map o
map n
map "'"
map '"'
map c
map e
map f

# --- file actions ---------------------------------------------------------
map e $$EDITOR "$f"
map E $$EDITOR -R "$f"
map u unzip
map az zip
map at tar
map DD trash
map tr restore_trash
map tc clear_trash
map T tag-toggle
map t open
map o brave
map . set hidden!
map p paste
map x cut
map y copy
map md mkdir
map mf mkfile
map r rename
map { half-up
map } half-down
map Y yank-path

# --- kali cd shortcuts ----------------------------------------------------
map gh   cd ~
map g.c  cd ~/.config
map g.d  cd ~/dotfiles
map g.l  cd ~/.local
map gla  cd /mnt/lattice-parity/lattice
map gdn  cd ~/Downloads
map gdo  cd ~/Documents
map gre  cd /etc
map gru  cd /usr
map grb  cd /bin
map grr  cd /
