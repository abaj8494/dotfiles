# macOS
.DS_Store

# Temporary files
*~
*.bak
*.old
*-temp/
*.zip

# Stow management
.stow-local-ignore
stow-packages/
restructure.sh
STOW-MIGRATION-PLAN.md

# =============================================================================
# Zsh - sensitive/generated files
# =============================================================================
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/.zsh_sessions/
zsh/.config/zsh/.zcompdump-*
zsh/.config/zsh/.z
zsh/.z

# =============================================================================
# Emacs - generated/cache files
# =============================================================================
emacs/.emacs.d/.lsp-session-v1
emacs/.emacs.d/.org-id-locations
emacs/.emacs.d/auto-save/
emacs/.emacs.d/eln-cache/
emacs/.emacs.d/elpa/
emacs/.emacs.d/straight/
emacs/.emacs.d/transient/
emacs/.emacs.d/org-roam.db
emacs/.emacs.d/recentf
emacs/.emacs.d/tramp
emacs/.emacs.d/bookmarks
emacs/.emacs.d/eshell/
emacs/.emacs.d/url/
emacs/.emacs.d/network-security.data
emacs/.emacs.d/org-msg-ltximg/
emacs/.emacs.d/*.elc
emacs/.emacs.d/elisp/*.elc
emacs/.emacs.d/message-drafts/
emacs/.emacs.d/scripts/__pycache__/
lattice/__pycache__/
.emacs.d.backup/
emacs.el

# =============================================================================
# Neovim - generated/cache files
# =============================================================================
nvim/.config/nvim/.undodir/
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/plugin/

# =============================================================================
# Karabiner - automatic backups
# =============================================================================
karabiner/.config/karabiner/automatic_backups/

# =============================================================================
# Hammerspoon - runtime logs and window-layout snapshots
# =============================================================================
hammerspoon/.hammerspoon/*.log
hammerspoon/.hammerspoon/window-layouts/

# =============================================================================
# Kitty - generated files
# =============================================================================
kitty/.config/kitty/macos-launch-services-cmdline

# =============================================================================
# htop - write-replace temp files
# =============================================================================
htop/.config/htop/htoprc.tmp.*

# =============================================================================
# GitHub CLI - credentials (sensitive)
# =============================================================================
gh/.config/gh/hosts.yml

# =============================================================================
# Temporary inquiry/notes files
# =============================================================================
inquiry*.txt
emacs/.emacs.d/savehist
